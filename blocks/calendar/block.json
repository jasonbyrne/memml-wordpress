{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "memml/calendar",
  "version": "0.4.5",
  "title": "Memml Calendar",
  "category": "widgets",
  "icon": "calendar",
  "description": "Let visitors switch between Memml events and volunteer opportunities.",
  "keywords": ["events", "calendar", "volunteer"],
  "textdomain": "memml",
  "editorScript": "memml-block-editor",
  "editorStyle": "memml-calendar",
  "style": "memml-calendar",
  "attributes": {
    "calendar": {
      "type": "string",
      "default": "",
      "enum": ["", "events", "volunteers"]
    },
    "view": {
      "type": "string",
      "default": "",
      "enum": ["", "list", "month"]
    },
    "listStyle": {
      "type": "string",
      "default": "",
      "enum": ["", "grid", "rows"]
    },
    "period": {
      "type": "string",
      "default": "",
      "enum": ["", "upcoming", "past"]
    },
    "urlKey": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "number",
      "default": -1
    },
    "subscribe": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "calendarSwitcher": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "layoutSwitcher": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "periodSwitcher": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showImages": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showDescriptions": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showItemCount": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showDetails": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showVenueCost": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showVolunteerAvailability": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showCancelledEvents": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showRsvp": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showRegistration": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showOnline": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showVolunteerSignup": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showAddToCalendar": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showEventPage": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    }
  },
  "supports": {
    "html": false
  }
}
