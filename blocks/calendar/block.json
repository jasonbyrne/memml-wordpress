{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "memml/calendar",
  "version": "0.2.0",
  "title": "Memml Calendar",
  "category": "widgets",
  "icon": "calendar",
  "description": "Let visitors switch between Memml events and volunteer opportunities.",
  "keywords": ["events", "calendar", "volunteer"],
  "textdomain": "memml",
  "editorScript": "memml-block-editor",
  "editorStyle": "memml-calendar",
  "style": "memml-calendar",
  "attributes": {
    "calendar": {
      "type": "string",
      "default": "events",
      "enum": ["events", "volunteers"]
    },
    "view": {
      "type": "string",
      "default": "list",
      "enum": ["list", "month"]
    },
    "period": {
      "type": "string",
      "default": "upcoming",
      "enum": ["upcoming", "past"]
    },
    "urlKey": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false
  }
}
