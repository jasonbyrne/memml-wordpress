{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "memml/volunteers",
  "version": "0.2.0",
  "title": "Memml Volunteers",
  "category": "widgets",
  "icon": "groups",
  "description": "Display public volunteer opportunities from Memml.",
  "keywords": ["volunteer", "opportunities", "nonprofit"],
  "textdomain": "memml",
  "editorScript": "memml-block-editor",
  "editorStyle": "memml-calendar",
  "style": "memml-calendar",
  "attributes": {
    "view": {
      "type": "string",
      "default": "list",
      "enum": ["list", "month"]
    },
    "period": {
      "type": "string",
      "default": "upcoming",
      "enum": ["upcoming", "past"]
    },
    "urlKey": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false
  }
}
