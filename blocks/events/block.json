{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "memml/events",
  "version": "0.4.4",
  "title": "Memml Events",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Display public events from Memml.",
  "keywords": ["events", "calendar", "nonprofit"],
  "textdomain": "memml",
  "editorScript": "memml-block-editor",
  "editorStyle": "memml-calendar",
  "style": "memml-calendar",
  "attributes": {
    "view": {
      "type": "string",
      "default": "",
      "enum": ["", "list", "month"]
    },
    "listStyle": {
      "type": "string",
      "default": "",
      "enum": ["", "grid", "rows"]
    },
    "period": {
      "type": "string",
      "default": "",
      "enum": ["", "upcoming", "past"]
    },
    "urlKey": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "number",
      "default": -1
    },
    "subscribe": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "layoutSwitcher": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "periodSwitcher": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showImages": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showDescriptions": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showItemCount": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showDetails": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showVenueCost": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showCancelledEvents": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showRegistration": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showOnline": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showVolunteerSignup": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    },
    "showAddToCalendar": {
      "type": "string",
      "default": "",
      "enum": ["", "yes", "no"]
    }
  },
  "supports": {
    "html": false
  }
}
