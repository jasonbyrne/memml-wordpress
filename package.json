{
  "name": "memml-wordpress",
  "version": "0.4.1",
  "private": true,
  "description": "Memml Calendar blocks for public events and volunteer opportunities.",
  "files": [
    "assets",
    "blocks",
    "build",
    "includes",
    "languages",
    "LICENSE",
    "memml.php",
    "README.md",
    "readme.txt",
    "uninstall.php"
  ],
  "scripts": {
    "build": "wp-scripts build",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style assets/calendar.css",
    "lint:js": "wp-scripts lint-js src assets/calendar.js scripts tests/e2e playwright.config.js",
    "package": "npm run build && wp-scripts plugin-zip --root-folder=memml && node scripts/finalize-package.js",
    "start": "wp-scripts start",
    "test:e2e": "playwright test",
    "test:wp-env": "wp-env run cli wp eval-file wp-content/plugins/memml-wordpress/tests/wp-env-smoke.php",
    "wp-env": "wp-env",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@wordpress/env": "^11.14.0",
    "@wordpress/scripts": "^34.2.0"
  },
  "dependencies": {
    "@wordpress/block-editor": "^17.0.0",
    "@wordpress/blocks": "^15.27.0",
    "@wordpress/components": "^40.0.0",
    "@wordpress/i18n": "^6.27.0",
    "@wordpress/server-side-render": "^6.30.0"
  }
}
